# Spring Profiles
# Use 'dev' for local development, 'prod' for cloud deployment
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL)
# These credentials must match your local MySQL or Docker configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doctor_appointment_db
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root

# Security (JWT)
# Secret key must be at least 256 bits (32+ characters) long.
# Do NOT use this exact key in a production environment.
JWT_SECRET_KEY=DefaultInsecureSecretKeyMustBeChangedInProd404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_TIME=86400000
JWT_REFRESH_EXPIRATION_TIME=604800000
